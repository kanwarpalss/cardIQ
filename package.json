{
  "name": "cardiq-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-sync.mjs",
    "dev": "node scripts/require-cardiq-port.mjs && next dev --port 3128",
    "build": "next build --webpack",
    "start": "node scripts/require-cardiq-port.mjs && next start --port 3128",
    "health": "tsx scripts/verify-login.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dining:login": "tsx scripts/dining-login.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@tailwindcss/typography": "^0.5.19",
    "googleapis": "^178.0.0",
    "imapflow": "^1.7.2",
    "mailparser": "^3.9.17",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.7.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.48.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
}
